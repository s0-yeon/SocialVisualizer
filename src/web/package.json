    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.97.2",
    "terser": "^5.44.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
