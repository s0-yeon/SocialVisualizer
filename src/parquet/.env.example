# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=social_visualizer_db

# 질의응답 (local_search/global_search)
# vLLM은 API 키를 검증하지 않지만, 코드에서 os.environ["LLM_API_KEY"]로 접근하므로
# 이 줄 자체를 지우면 KeyError가 발생한다. 값은 더미로 두면 된다.
LLM_API_KEY=dummy
MODEL_PROVIDER=openai
RAG_CHAT_MODEL=socialvisualizer-llama-query
RAG_CHAT_API_BASE=http://localhost:8004/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3

LOCAL_API_KEY=not-needed

# 인덱싱 (extract_graph/community_reports)
INDEXING_CHAT_MODEL=socialvisualizer-llama-index
INDEXING_API_BASE=http://localhost:8002/v1

INDEXING_EMBEDDING_MODEL=BAAI/bge-m3
INDEXING_EMBEDDING_API_BASE=http://localhost:8001/v1

# 로컬 모델을 쓰려면 아래 값 그대로 둔다.
# 인덱싱에 다른 AI를 쓰고 싶다면 아래 두 값을 default_chat_model / default_embedding_model로
# 바꾼다. 이때 실제로 연결되는 모델은 위 RAG_CHAT_MODEL / RAG_CHAT_API_BASE이므로,
# 그 값을 원하는 모델로 먼저 바꿔둔다.
INDEXING_COMPLETION_MODEL_ID=indexing_chat_model
INDEXING_EMBEDDING_MODEL_ID=indexing_embedding_model
INDEXING_REPORTS_MODEL_ID=indexing_chat_model_reports

# 부가 기능 (질의 분류·첨부파일 요약·메일 요약 등)
SUB_TASK_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
SUB_TASK_API_BASE=http://localhost:8003/v1

# 아바타 이미지 생성
# 이미지 생성은 별도 GPU 서버(FLUX.1-schnell)에서 이루어지며,
# 앱은 이 서버를 호출만 하므로 API 주소만 있으면 된다.
IMAGE_API_BASE=http://localhost:8005
